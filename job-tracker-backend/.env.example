DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_tracker
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Optional: only required for GET /jobs/search. Get a free key at
# https://www.openwebninja.com/api/jsearch (no credit card required for the free tier)
JSEARCH_API_KEY=
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: only required for POST /ats/score. Get a free key at
# https://ai.google.dev (no credit card required)
GEMINI_API_KEY=

# Gemini model to use for ATS scoring
GEMINI_MODEL=gemini-2.5-flash
